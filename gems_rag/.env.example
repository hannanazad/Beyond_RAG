# GEMS-RAG — environment variables
#
# Copy this file to .env, fill in only the keys you actually need, then run:
#     set -a; source .env; set +a
#
# .env is git-ignored. Never commit real keys.
# On Google Colab use the Secrets panel (key icon in the sidebar) instead of
# this file — the notebooks read Colab secrets automatically.

# ---------------------------------------------------------------------------
# Answer models. You need ONE of these — whichever provider your chosen model
# belongs to. Run CFG.list_vlm_models() to see the catalog.
# ---------------------------------------------------------------------------

# Claude models  (claude-fable-5, claude-sonnet-5, claude-haiku-4-5)
ANTHROPIC_API_KEY=

# Gemini models  (gemini-3.1-pro-preview, gemini-3.5-flash, gemini-3.1-flash-lite)
GEMINI_API_KEY=

# Qwen models via Alibaba DashScope  (qwen3.7-max, qwen3-vl-*, qwen3.6-flash)
DASHSCOPE_API_KEY=

# Generic fallback read by mrag/vlm.py when a provider-specific key is absent.
# Leave blank unless you know you need it.
VLM_API_KEY=

# ---------------------------------------------------------------------------
# Baseline comparison only (comparison/). GraphRAG and PaperQA call OpenAI to
# build their indexes. BM25 and GEMS-RAG do not need this.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Model ids used when rebuilding the baseline indexes.
GRAPHRAG_LLM_MODEL=
GRAPHRAG_EMBEDDING_MODEL=
GRAPHRAG_QUERY_LLM_MODEL=
GRAPHRAG_QUERY_EMBEDDING_MODEL=
PAPERQA_EMBEDDING_MODEL=
PAPERQA_LLM_MODEL=
PAPERQA_SUMMARY_MODEL=

# ---------------------------------------------------------------------------
# Optional paths. Sensible defaults apply if you leave these unset.
# ---------------------------------------------------------------------------

# Where this repository lives (the notebooks set this themselves on Colab).
# GEMSRAG_ROOT=/content/gemsrag

# Prebuilt Qdrant vector store, packaged as a .tar
# GEMSRAG_QDRANT_TAR=/content/drive/MyDrive/MRAG/qdrant_db.tar

# Where ablation result archives are written
# GEMSRAG_RESULTS=/content/drive/MyDrive/MRAG/ablations

# Hugging Face model cache. Point this at persistent storage so the ~10 GB of
# model weights are downloaded only once.
# HF_HOME=/content/drive/MyDrive/hf_cache

# Environment hint used by mrag/config.py: colab | hprc | local
# MRAG_ENV=colab
# MRAG_BASE_DIR=
